# PythonAnywhere Environment Variables
# Set these in the PythonAnywhere web app configuration or in a .env file

# Django secret key (generate a new one for production)
DJANGO_SECRET_KEY=your-production-secret-key-here

# Debug mode (set to False in production)
DJANGO_DEBUG=False

# Allowed hosts (your PythonAnywhere domain)
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com

# CORS frontend URL (your Vercel frontend URL)
CORS_FRONTEND_URL=https://your-portfolio.vercel.app
